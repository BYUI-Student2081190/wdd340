<%# Content Heading %>
<% if (title) { %>
    <h1><%= title %></h1>
    <% } else {
      res.redirect('/')
} %>

<%# Flash Message %>
<%- messages() %>

<%# For Those Times When Errors Happen%>
<% if (errors) { %>
    <ul class="notice">
    <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
    <% }) %>
    </ul>
<% } %>

<div id="view-employee-data">
        <h3>First Name: </h3>
        <p><%= locals.account_firstname %></p>
        <h3>Last Name: </h3>
        <p><%= locals.account_lastname %></p>
        <h3>Job Title: </h3>
        <p><%= locals.employee_title %></p>
        <h3>Job Description: </h3>
        <p><%= locals.employee_description %></p>
        <h3>Salary</h3>
        <p><%= locals.employee_salary %></p>
        <h3>Shift Time: </h3>
        <p><%= locals.employee_shiftstart %> to <%= locals.employee_shiftend %></p>
        <h3>Work Days: </h3>
        <p><%= locals.employee_shiftdays %></p>
</div>

<% if (locals.accountData.account_type === 'Employee') { %>
    <%# Go back to account-management %>
    <div class="goBack">
        <a href="/account/">Go Back</a>
    </div>
<% } %>
<% if (locals.accountData.account_type === 'Admin') { %>
    <%# Go back to employee-management %>
    <div class="goBack">
        <a href="/account/employee-management">Go Back</a>
    </div>
<% } %>